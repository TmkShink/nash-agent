{
  "name": "nash-agent",
  "version": "0.1.0",
  "description": "A small, inspectable coding agent built from scratch",
  "type": "module",
  "bin": {
    "nash": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test",
    "dev": "node --import tsx --env-file=.env.local src/cli/main.ts",
    "test": "node --import tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.11"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
